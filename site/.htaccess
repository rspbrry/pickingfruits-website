# PickingFruits: Server-Konfiguration für IONOS (Apache)

# --- Standard-Dokument, kein Verzeichnis-Listing, eigene 404-Seite ---
DirectoryIndex index.html
ErrorDocument 404 /404.html
<IfModule mod_autoindex.c>
  IndexIgnore *
</IfModule>

# --- Weiterleitungen ---
<IfModule mod_rewrite.c>
  RewriteEngine On

  # www -> ohne www (nur für die Hauptdomain, damit Test-Subdomains unberührt bleiben)
  RewriteCond %{HTTP_HOST} ^www\.pickingfruits\.de$ [NC]
  RewriteRule ^ https://pickingfruits.de%{REQUEST_URI} [R=301,L]

  # http -> https
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Alte WordPress-Adressen auf die neuen Seiten umleiten (erhält Links und Google-Einträge)
  RewriteRule ^impressum/?$ /impressum.html [R=301,L]
  RewriteRule ^datenschutz/?$ /datenschutz.html [R=301,L]
  RewriteRule ^privacy-policy/?$ /datenschutz.html [R=301,L]
  RewriteRule ^terms-and-conditions/?$ / [R=301,L]
  RewriteRule ^agb(\.html)?/?$ / [R=301,L]
</IfModule>

# --- Dateitypen ---
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType video/mp4 .mp4
  AddType image/svg+xml .svg
  AddType image/x-icon .ico
  AddDefaultCharset UTF-8
</IfModule>

# --- GZIP-Komprimierung ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript application/javascript application/json application/ld+json image/svg+xml application/xml
</IfModule>

# --- Browser-Caching ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType video/mp4 "access plus 6 months"
  ExpiresByType text/plain "access plus 1 day"
  ExpiresByType application/xml "access plus 1 day"
</IfModule>

# --- Sicherheits-Header ---
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
